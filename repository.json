    "packages": [
        {
            "name": "laveroadmin/activity-log",
            "title": {
                "en": "Activity Log & Audit",
                "ru": "Журнал активности и аудит"
            },
            "description": {
                "en": "Track user activity and model attribute diffs powered by Spatie Activitylog.",
                "ru": "Журналирование действий пользователей и аудит изменений моделей на базе Spatie Activitylog."
            },
            "category": "security",
            "icon": "icon-history",
            "version": "1.0.0",
            "author": {
                "name": "Aleksandr Kireev",
                "email": "hello@bespredel.name",
                "url": "https://bespredel.name"
            },
            "github": "https://github.com/LaveroAdmin/activity-log",
            "setup": {
                "commands": [
                    {
                        "cmd": "php artisan vendor:publish --provider=\"Spatie\\Activitylog\\ActivitylogServiceProvider\" --tag=\"activitylog-migrations\"",
                        "desc": {
                            "en": "Publish activity_log database migrations",
                            "ru": "Публикация миграций таблицы activity_log"
                        }
                    },
                    {
                        "cmd": "php artisan migrate",
                        "desc": {
                            "en": "Run database migrations",
                            "ru": "Применение миграций"
                        }
                    },
                    {
                        "cmd": "php artisan admin:import activity-log",
                        "desc": {
                            "en": "Import admin menu item and permissions",
                            "ru": "Импорт пункта меню журнала активности"
                        }
                    }
                ],
                "config": {
                    "file": "config/admin.php",
                    "code": "'activity-log' => [\n    'enable' => true,\n],"
                },
                "requirements": {
                    "en": [
                        "PHP >= 8.1"
                    ],
                    "ru": [
                        "PHP >= 8.1"
                    ]
                },
                "notes": {
                    "en": [
                        "Add the Spatie\\Activitylog\\Traits\\LogsActivity trait to Eloquent models you wish to track.",
                        "Implement getActivitylogOptions(): LogOptions in your tracked models."
                    ],
                    "ru": [
                        "Подключите trait Spatie\\Activitylog\\Traits\\LogsActivity в Eloquent модели, изменения которых вы хотите отслеживать.",
                        "В моделях определите метод getActivitylogOptions(): LogOptions."
                    ]
                }
            },
            "key": "activity-log",
            "compatibility": {
                "php": ">=8.1",
                "laravel": "^10.0 || ^11.0 || ^12.0 || ^13.0",
                "admin": "^1.0",
                "extensions": [
                    "pdo"
                ]
            }
        },
        {
            "name": "laveroadmin/backup",
            "title": {
                "en": "Backup Manager",
                "ru": "Менеджер бэкапов"
            },
            "description": {
                "en": "Manage database and file backups with multi-disk support powered by Spatie Backup.",
                "ru": "Управление резервными копиями базы данных и файлов с поддержкой Spatie Backup."
            },
            "category": "system",
            "icon": "icon-copy",
            "version": "1.0.0",
            "author": {
                "name": "Aleksandr Kireev",
                "email": "hello@bespredel.name",
                "url": "https://bespredel.name"
            },
            "github": "https://github.com/LaveroAdmin/backup",
            "setup": {
                "commands": [
                    {
                        "cmd": "php artisan vendor:publish --provider=\"Spatie\\Backup\\BackupServiceProvider\"",
                        "desc": {
                            "en": "Publish Spatie Backup configuration file (config/backup.php)",
                            "ru": "Публикация конфигурационного файла Spatie Backup (config/backup.php)"
                        }
                    },
                    {
                        "cmd": "php artisan admin:import backup",
                        "desc": {
                            "en": "Import admin menu item and permissions",
                            "ru": "Импорт пункта меню и прав доступа в панель управления"
                        }
                    }
                ],
                "config": {
                    "file": "config/admin.php",
                    "code": "'backup' => [\n    'enable' => true,\n],"
                },
                "requirements": {
                    "en": [
                        "PHP >= 8.1",
                        "mysqldump or sqlite3 utility in system PATH for database dumps"
                    ],
                    "ru": [
                        "PHP >= 8.1",
                        "Утилиты mysqldump или sqlite3 в PATH для создания дампов баз данных"
                    ]
                },
                "notes": {
                    "en": [
                        "Configure destination disks in config/backup.php (e.g., local, s3, backup).",
                        "To run backups automatically, add to routes/console.php: Schedule::command('backup:run')->daily();"
                    ],
                    "ru": [
                        "Настройте диски назначения в файле config/backup.php (например, local, s3, backup).",
                        "Для регулярных бэкапов добавьте в routes/console.php: Schedule::command('backup:run')->daily();"
                    ]
                }
            },
            "key": "backup",
            "compatibility": {
                "php": ">=8.1",
                "laravel": "^10.0 || ^11.0 || ^12.0 || ^13.0",
                "admin": "^1.0",
                "extensions": [
                    "pdo",
                    "zip"
                ]
            }
        },
